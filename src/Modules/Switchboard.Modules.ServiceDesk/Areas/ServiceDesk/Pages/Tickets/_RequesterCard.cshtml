@model Switchboard.Modules.ServiceDesk.Services.TicketPageData
@{
    var r = Model.Ticket.Requester!;
    var department = r.Department?.Name;
    var details = string.Join(", ", new[] { r.JobTitle, department }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<section class="sb-pane sd-requester" aria-labelledby="sdRequesterTitle">
    <div class="sb-pane-header">
        <h2 class="sb-pane-title" id="sdRequesterTitle">Requester</h2>
    </div>
    <div class="sb-pane-body">
        <div class="sd-person">
            <sb-avatar name="@r.DisplayName" size="lg" />
            <div class="min-w-0">
                <div class="sd-person-name">
                    <span>@r.DisplayName</span>
                    @if (r.IsVip)
                    {
                        <span class="sb-vip">VIP</span>
                    }
                </div>
                @if (details.Length > 0)
                {
                    <div class="sb-meta">@details</div>
                }
                @if (!string.IsNullOrWhiteSpace(r.Email) && !r.IsForgotten)
                {
                    <a class="sd-person-email text-truncate" href="mailto:@r.Email">@r.Email</a>
                }
                @if (!string.IsNullOrWhiteSpace(r.PhoneNumber) || !string.IsNullOrWhiteSpace(r.Mobile))
                {
                    <div class="sb-meta"><i class="bi bi-telephone me-1" aria-hidden="true"></i>@(r.PhoneNumber ?? r.Mobile)</div>
                }
            </div>
        </div>

        <p class="sb-section-label mt-3 mb-1">Recent tickets</p>
        @if (Model.RequesterRecent.Count == 0)
        {
            <p class="text-muted small m-0">This is their first ticket you can see.</p>
        }
        else
        {
            <ul class="sd-mini-list sd-mini-list--tight">
                @foreach (var recent in Model.RequesterRecent)
                {
                    <partial name="_TicketRow" model="recent" />
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(r.Email))
            {
                <a class="small" href="/tickets?q=@Uri.EscapeDataString($"requester:{r.Email}")&amp;sort=-created">See all their tickets</a>
            }
        }
    </div>
</section>
