@model Switchboard.Modules.ServiceDesk.Areas.ServiceDesk.Pages.Tickets.CandidatesModel
@if (string.IsNullOrWhiteSpace(Model.Query))
{
}
else if (Model.Tickets.Count == 0)
{
    <p class="sb-meta mt-2 mb-0">No open tickets in this workspace match "@Model.Query".</p>
}
else
{
    @foreach (var c in Model.Tickets)
    {
        var id = $"{Model.Mode}-{c.Id:N}";
        <div class="sd-candidate" data-sd-candidate="@c.Id">
            @if (Model.Mode == "merge")
            {
                <input class="form-check-input" type="checkbox" name="others" id="@id" value="@c.Id" data-sd-merge-pick>
                <label class="form-check-label" for="@id"><span class="sb-stamp">@c.DisplayId</span> @c.Subject</label>
                <sb-status name="@c.StatusName" category="@c.StatusCategory" />
                <span class="sd-candidate-keep">
                    <input class="form-check-input" type="radio" name="primaryId" id="keep-@id" value="@c.Id">
                    <label class="form-check-label small" for="keep-@id">Keep this one</label>
                </span>
            }
            else
            {
                <input class="form-check-input" type="radio" name="targetId" id="@id" value="@c.Id" required>
                <label class="form-check-label" for="@id"><span class="sb-stamp">@c.DisplayId</span> @c.Subject</label>
                <sb-status name="@c.StatusName" category="@c.StatusCategory" />
            }
        </div>
    }
}
