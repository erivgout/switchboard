@page "/admin/people/new"
@model Switchboard.Modules.Admin.Pages.People.NewModel
@{
    var title = Model.IsAgent ? "Add an agent" : "Add a requester";
    ViewData["Title"] = title;
    var back = (Model.IsAgent ? "/admin/people?kind=agents" : "/admin/people?kind=requesters", "People");
    var scopes = new[] { TicketScope.Global, TicketScope.Group, TicketScope.Restricted };
}
<partial name="_BackLink" model="back" />
<sb-page-header title="@title" subtitle="@(Model.IsAgent ? "Agents work tickets in the workspaces where they have a role." : "Requesters raise tickets and use the portal.")" />

<form method="post" class="sb-form-narrow" novalidate>
    <input type="hidden" name="Kind" value="@Model.Kind">
    <partial name="_Errors" />
    <div class="sb-pane">
        <div class="sb-pane-body">
            <partial name="_ProfileFields" model="Model.Form" />

            @if (Model.IsAgent)
            {
                <fieldset class="sb-fieldset">
                    <legend class="sb-section-label">Access</legend>
                    <div class="row g-3">
                        @if (Model.Workspaces.Count > 1)
                        {
                            <div class="col-12">
                                <label class="form-label" asp-for="WorkspaceId">Workspace</label>
                                <select class="form-select" asp-for="WorkspaceId">
                                    @foreach (var w in Model.Workspaces)
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="WorkspaceId">
                        }
                        <div class="col-md-6">
                            <label class="form-label" asp-for="RoleId">Role</label>
                            <select class="form-select" asp-for="RoleId" asp-items="Model.Roles"></select>
                            <partial name="_FieldError" model="@("RoleId")" />
                            <partial name="_FieldError" model="@("Input.RoleId")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Scope">Tickets they can see</label>
                            <select class="form-select" asp-for="Scope">
                                @foreach (var scope in scopes)
                                {
                                    <option value="@scope">@AdminPageModel.ScopeLabel(scope)</option>
                                }
                            </select>
                        </div>
                    </div>
                </fieldset>
            }

            <div class="form-check">
                <input class="form-check-input" asp-for="Invite">
                <label class="form-check-label" asp-for="Invite">Email an invitation to choose a password</label>
            </div>
            <div class="form-text">@(Model.IsAgent ? "Agents need a password to sign in." : "Requesters can also sign in later through Forgot password, or just use email.")</div>
        </div>
        <div class="sb-pane-footer d-flex gap-2">
            <button class="btn btn-primary" type="submit">@(Model.IsAgent ? "Add agent" : "Add requester")</button>
            <a class="btn btn-ghost" href="@back.Item1">Cancel</a>
        </div>
    </div>
</form>
