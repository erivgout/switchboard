@model SecretRevealModel
<div class="sb-secret" role="status">
    <p class="sb-secret-title"><i class="bi bi-check2-circle" aria-hidden="true"></i> @Model.Title</p>
    <div class="sb-secret-row">
        <code class="sb-secret-value" id="@Model.Id">@Model.Secret</code>
        <button type="button" class="btn btn-primary btn-sm" data-sb-copy="#@Model.Id" data-sb-copied="Copied">
            <i class="bi bi-clipboard" aria-hidden="true"></i> <span>Copy</span>
        </button>
    </div>
    @if (Model.Hint is { } hint)
    {
        <p class="sb-meta mb-0">@hint</p>
    }
</div>
