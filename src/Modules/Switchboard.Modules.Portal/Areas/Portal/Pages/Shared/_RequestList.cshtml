@model RequestListModel
<ul class="prt-list">
    @foreach (var r in Model.Items)
    {
        <li>
            <a class="prt-row" href="/portal/requests/@r.Number">
                <span class="sb-stamp prt-row-id">@r.DisplayId</span>
                <span class="prt-row-subject">@r.Subject</span>
                <span class="prt-row-meta">
                    @if (Model.ShowRequester && !r.IsMine)
                    {
                        <span>@r.RequesterName,</span>
                    }
                    <span>updated <sb-time value="@r.UpdatedAt" /></span>
                </span>
                <span class="prt-row-status"><sb-status name="@r.StatusName" category="@r.StatusCategory" for-requester="true" requester-label="@r.StatusLabel" /></span>
            </a>
        </li>
    }
</ul>
