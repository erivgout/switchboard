@page "/account/login-2fa"
@model Switchboard.Web.Pages.Account.Login2faModel
@{
    ViewData["Title"] = "Two-step verification";
    Layout = "_AuthLayout";
}
<h1>Enter your code</h1>
<p class="text-muted mb-4">Open your authenticator app and enter the 6-digit code for Switchboard. Lost your device? Use one of your recovery codes instead.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl">
    <input type="hidden" asp-for="RememberMe">
    <div class="mb-3">
        <label class="form-label" asp-for="Code">Authenticator or recovery code</label>
        <input class="form-control form-control-lg tabular" asp-for="Code" autocomplete="one-time-code" inputmode="text" autofocus required>
    </div>
    <div class="form-check mb-4">
        <input class="form-check-input" asp-for="RememberDevice">
        <label class="form-check-label" asp-for="RememberDevice">Don't ask again on this device for 30 days</label>
    </div>
    <button class="btn btn-primary w-100" type="submit">Verify and sign in</button>
</form>
<p class="mt-4"><a href="/account/login">Use a different account</a></p>
