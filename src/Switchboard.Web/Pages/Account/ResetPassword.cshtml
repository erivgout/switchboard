@page "/account/reset-password"
@model Switchboard.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}
<h1>Choose a new password</h1>
<p class="text-muted mb-4">Use at least 12 characters. A short sentence is easier to remember than random symbols.</p>

<div asp-validation-summary="All" class="alert alert-danger" role="alert" hidden="@ModelState.IsValid"></div>

<form method="post">
    <input type="hidden" asp-for="Email">
    <input type="hidden" asp-for="Token">
    <div class="mb-3">
        <label class="form-label" asp-for="Password">New password</label>
        <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" minlength="12" autofocus required>
    </div>
    <div class="mb-4">
        <label class="form-label" asp-for="Confirm">Type it again</label>
        <input class="form-control" asp-for="Confirm" type="password" autocomplete="new-password" required>
    </div>
    <button class="btn btn-primary w-100" type="submit">Save new password</button>
</form>
