@page "/account/forgot-password"
@model Switchboard.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
    Layout = "_AuthLayout";
}
@if (Model.Sent)
{
    <h1>Check your email</h1>
    <p class="text-muted">If an account uses that address, we sent it a link to choose a new password. The link works for one hour.</p>
    <a class="btn btn-outline-secondary mt-3" href="/account/login">Back to sign in</a>
}
else
{
    <h1>Reset your password</h1>
    <p class="text-muted mb-4">Enter the email you sign in with and we'll send you a reset link.</p>
    <form method="post">
        <div class="mb-4">
            <label class="form-label" asp-for="Email">Email</label>
            <input class="form-control" asp-for="Email" type="email" autocomplete="username" autofocus required>
        </div>
        <button class="btn btn-primary w-100" type="submit">Send reset link</button>
    </form>
    <p class="mt-4"><a href="/account/login">Back to sign in</a></p>
}
