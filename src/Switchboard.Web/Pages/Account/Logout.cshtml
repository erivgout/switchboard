@page "/account/logout"
@model Switchboard.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
    Layout = "_AuthLayout";
}
<h1>Sign out?</h1>
<form method="post" class="mt-3">
    <button class="btn btn-primary" type="submit">Sign out</button>
    <a class="btn btn-outline-secondary ms-2" href="/">Stay signed in</a>
</form>
