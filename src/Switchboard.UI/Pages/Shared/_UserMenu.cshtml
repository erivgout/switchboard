@model ShellModel
@{
    var user = Model.User!;
}
<div class="dropdown">
    <button class="btn btn-ghost btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu for @user.Name">
        <sb-avatar name="@user.Name" size="sm" />
    </button>
    <div class="dropdown-menu dropdown-menu-end" style="min-width: 15rem">
        <div class="px-3 py-2">
            <div class="fw-semibold">@user.Name</div>
            <div class="small text-muted text-truncate">@user.Email</div>
        </div>
        <hr class="dropdown-divider">
        <a class="dropdown-item" href="/profile"><i class="bi bi-person-gear me-2" aria-hidden="true"></i>Profile and security</a>
        <sb-slot name="usermenu.items" model="Model" />
        <hr class="dropdown-divider">
        <div class="px-3 pt-1 pb-2">
            <div class="small text-muted mb-1" id="sbThemeLabel">Theme</div>
            <div class="btn-group btn-group-sm w-100" role="group" aria-labelledby="sbThemeLabel">
                <button type="button" class="btn btn-outline-secondary" data-sb-theme-set="light">Light</button>
                <button type="button" class="btn btn-outline-secondary" data-sb-theme-set="dark">Dark</button>
                <button type="button" class="btn btn-outline-secondary" data-sb-theme-set="auto">Auto</button>
            </div>
        </div>
        <hr class="dropdown-divider">
        <form method="post" action="/account/logout" asp-antiforgery="true">
            <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
        </form>
    </div>
</div>
